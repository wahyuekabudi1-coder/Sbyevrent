# GEMINI_API_KEY: Optional for AI Studio runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ArtoPay Payment Gateway Credentials
# Disediakan oleh PT Sawah Jaya Trans / Akun ArtoPay
ARTOPAY_MERCHANT_ID="MCH-SJTRANS-001"
