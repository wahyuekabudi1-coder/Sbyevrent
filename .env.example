# Saat belum live atau testing tanpa memotong dana nyata, backend mengaktifkan mode simulasi verifikasi
ARTOPAY_SANDBOX_MODE="true"

# Keamanan & Autentikasi
ADMIN_DEFAULT_PASSWORD="admin_sjtrans_secure"
