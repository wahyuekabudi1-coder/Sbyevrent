# ==============================================================
# PT SAWAH JAYA TRANS - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================
# Petunjuk: Salin file ini menjadi .env untuk development lokal.
# JANGAN PERNAH mengunggah file .env yang berisi nilai asli ke GitHub!
# Masukkan nilai variabel ini pada menu Project Settings > Environment Variables di dashboard Vercel.

# --------------------------------------------------------------
# 1. AUTENTIKASI PENGELOLA (ADMIN ACCESS)
# --------------------------------------------------------------
# Password atau PIN default untuk membuka dashboard manajemen internal.
ADMIN_DEFAULT_PASSWORD=
ADMIN_PIN=

# --------------------------------------------------------------
# 2. FRONTEND API ROUTING (OPSIONAL)
# --------------------------------------------------------------
# Kosongkan jika frontend dan backend berjalan pada domain yang sama (Vercel Serverless Function).
# Isi dengan URL backend jika backend Express di-host terpisah (misalnya di Render/Railway):
# Contoh: VITE_API_URL=https://api-sjt.onrender.com
VITE_API_URL=

# --------------------------------------------------------------
# 3. SERVER CONFIGURATION
# --------------------------------------------------------------
PORT=3000
NODE_ENV=production
SESSION_SECRET=

# --------------------------------------------------------------
# 5. EXTERNAL SERVICES & AI (OPSIONAL)
# --------------------------------------------------------------
GEMINI_API_KEY=